# Generated BEM/search working data. Final reports and selected source artifacts
# are unignored by project-specific rules below when they belong in Git.
examples/**/candidates/**/*
examples/**/search_report.html
examples/**/search_run.log
examples/**/search_state.json
examples/**/coverage_diagnostics.json
examples/**/finalist_comparison.html
examples/**/search_batch.*
examples/**/candidate_field.csv

# Generated mouth-size coverage-grid outputs. Keep final reports and surface
# STLs; leave materialized candidate projects, solver data, logs, and state local.
examples/mouth-size-coverage-grid/search_batch.*
examples/mouth-size-coverage-grid/**/search_run.log
examples/mouth-size-coverage-grid/**/search_state.json
examples/mouth-size-coverage-grid/**/coverage_diagnostics.json
examples/mouth-size-coverage-grid/**/finalist_comparison.html
examples/mouth-size-coverage-grid/**/candidates/**/*
!examples/mouth-size-coverage-grid/**/search_report.html
!examples/mouth-size-coverage-grid/**/candidates/**/
!examples/mouth-size-coverage-grid/**/candidates/candidate-*/project.yaml
!examples/mouth-size-coverage-grid/**/candidates/candidate-*/*.STL
!examples/mouth-size-coverage-grid/**/candidates/candidate-*/bem/responses.npz
!examples/mouth-size-coverage-grid/**/candidates/candidate-*/bem/*_Report.html

# Retained reference-search artifacts use the same canonical public names.
!examples/osse-400x280-reference/**/candidates/**/
!examples/osse-400x280-reference/**/candidates/candidate-*/*.STL
